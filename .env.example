# Database Configuration (Phase 1A - Neon Bootstrap)
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/waifu_db

# For SQLite (default for development):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Neon Database (Phase 1A - Production):
# NEON_DATABASE_URL=postgresql+asyncpg://username:password@neon-host/dbname

# Database password for CLI operations (optional)
# PGPASSWORD=your_database_password

# Python path for imports
# PYTHONPATH=.

# Backblaze B2 Storage Configuration
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_ID=your-bucket-id
B2_DOWNLOAD_URL=https://your-bucket.example.com

# External Service URLs
BACKGROUND_REMOVER_URL=https://example.com/background-remover
SEEDREAM_URL=https://example.com/seedream
GOOGLE_GENERATION_URL=https://example.com/google-generation

# Application Settings
DEBUG=false
ENVIRONMENT=local
CATALOG_REFRESH_CRON=0 3 * * *
FEATURE_WORKFLOWS_ENABLED=true


# Analytics Configuration
ANALYTICS_ENABLED=true
USER_SESSION_TIMEOUT_HOURS=24
ASSET_CLEANUP_DAYS=30
